---
/** Colophon footer. */
import { t } from '../lib/i18n'
import { TOTAL_PARTS } from '../lib/chapters'
import type { Locale } from '../lib/chapters'

export interface Props {
  locale: Locale
}
const { locale } = Astro.props
---

<footer class="mt-24 px-6 pb-12 lg:px-8">
  <div class="mx-auto max-w-canvas">
    <div aria-hidden="true" class="relative h-px w-full overflow-hidden bg-text-primary/10">
      <span class="absolute inset-y-0 left-0 w-1/4 bg-accent-thread/80 animate-thread-drift"></span>
    </div>
    <div class="mt-8 md:flex md:items-end md:justify-between">
      <div>
        <p class="font-sans text-xs sm:text-sm font-light uppercase tracking-[0.18em] sm:tracking-[0.32em] text-text-primary">
          {locale === 'vi' ? 'Những Người Thấy Sợi Chỉ' : 'The Thread Seers'}
        </p>
        <p class="mt-3 font-mono text-xs tracking-[0.14em] text-text-secondary">
          {t(locale, 'nav.footerNote')}
        </p>
        <p class="mt-2 text-sm text-text-secondary">
          © {new Date().getFullYear()} {locale === 'vi' ? 'Lê Việt Hồng' : 'Le Viet Hong'}.{' '}
          {t(locale, 'common.rights')}.
        </p>
      </div>
      <p class="mt-8 font-mono text-xs uppercase tracking-[0.18em] text-text-muted md:mt-0">
        {TOTAL_PARTS} {locale === 'vi' ? 'phần · EN / VI' : 'parts · EN / VI'}
      </p>
    </div>
  </div>
</footer>
