---
import Base from '../../layouts/Base.astro'
import Page from '../../components/Page.astro'
import HoldCta from '../../components/HoldCta.astro'
import PullQuote from '../../components/PullQuote.astro'
import RelationshipMap from '../../components/RelationshipMap.astro'
import ThreadDivider from '../../components/ThreadDivider.astro'
import ThreadSample from '../../components/ThreadSample.astro'
import { isLocale, TOTAL_PARTS } from '../../lib/chapters'
import { t } from '../../lib/i18n'
import { SITE, jsonLd, keywordsFor, localePath, faq } from '../../lib/seo'
import { premise, quartetFor, fieldNotes } from '../../lib/pages'
import { THREAD } from '../../lib/content'

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'vi' } }]
}

const lang = Astro.params.lang!
if (!isLocale(lang)) return Astro.redirect('/en/')
const locale = lang
const tr = (k: Parameters<typeof t>[1], v?: Record<string, string | number>) => t(locale, k, v)

const title =
  locale === 'vi'
    ? 'Những Người Thấy Sợi Chỉ — Toàn văn song ngữ Anh - Việt, đọc miễn phí'
    : 'The Thread Seers — Read and download free in English and Vietnamese'
const description =
  locale === 'vi'
    ? 'Cô nghệ sĩ mười sáu tuổi Lyra Chen âm thầm phác họa “bản đồ quan hệ” bên lề tập vở cho đến khi những vệt than chì bừng sáng giữa thinh không. Sách Một trọn vẹn đọc trực tuyến và tải về miễn phí bằng cả tiếng Anh lẫn tiếng Việt.'
    : 'Sixteen-year-old artist Lyra Chen charts the quiet currents between people in her notebook margins — until the lines ignite into living light. Book One is free to read online and download unabridged in English and Vietnamese.'

const epub =
  locale === 'vi'
    ? '/books/the_thread_seers_sach_mot.epub'
    : '/books/the_thread_seers_epub3.epub'

const schema = jsonLd({
  locale,
  path: '/',
  title,
  description,
  type: 'website',
  faq: faq[locale],
  withSeries: true,
  withBook: true,
})

const premiseRows = premise
const quartetNodes = quartetFor(locale)
const cover = SITE.cover
---

<Base
  locale={locale}
  path="/"
  title={title}
  description={description}
  keywords={keywordsFor(locale)}
  jsonLd={schema}
  type="website"
>
  <Page locale={locale} path="/">
    <main>
      {/* ——— Thread-sight hero ——— */}
      <section class="relative overflow-hidden">
        <svg
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
          viewBox="0 0 1200 700"
          preserveAspectRatio="xMidYMid slice"
        >
          <path
            d="M-40 140 C 260 90, 420 260, 760 190 S 1120 300, 1260 220"
            fill="none"
            stroke={THREAD.gold}
            stroke-width="1.2"
            class="animate-thread-breathe"></path>
          <path
            d="M-40 420 C 300 470, 520 330, 820 430 S 1100 380, 1260 440"
            fill="none"
            stroke="rgba(242,239,230,0.16)"
            stroke-width="1"
            class="animate-thread-breathe"
            style="animation-delay:1.2s"></path>
          <path
            d="M-40 600 C 240 560, 560 660, 880 590 S 1140 620, 1260 580"
            fill="none"
            stroke="rgba(198,161,91,0.45)"
            stroke-width="1"
            class="animate-thread-breathe"
            style="animation-delay:2.4s"></path>
        </svg>

        <div
          class="mx-auto grid max-w-canvas gap-12 px-6 pb-20 pt-16 sm:pt-24 lg:grid-cols-12 lg:gap-8 lg:px-8 lg:pb-28 lg:pt-32"
        >
          <div class="lg:col-span-7">
            <p class="eyebrow">{tr('home.eyebrow')}</p>
            <h1 class="mt-6 font-display text-hero font-light text-text-primary">
              {locale === 'vi' ? (
                <>
                  Cô vẽ những đường <ThreadSample length={0.62} /> giữa người với người — rồi chúng bắt đầu{' '}
                  <ThreadSample length={0.5} color={THREAD.silver} /> bừng sáng.
                </>
              ) : (
                <>
                  She drew the lines <ThreadSample length={0.62} /> between people — then they began{' '}
                  <ThreadSample length={0.5} color={THREAD.silver} /> to glow.
                </>
              )}
            </h1>
            <p class="mt-8 max-w-prose font-serif text-body leading-relaxed text-text-body">
              {tr('home.intro')}
            </p>
            <div class="mt-10 flex flex-col items-start gap-5">
              <HoldCta
                locale={locale}
                href={epub}
                label={tr('home.cta')}
                hint={tr('home.ctaHint')}
              />
              <a href={localePath(locale, '/series/book-one/read/prologue')} class="ghost-link text-text-secondary hover:text-text-primary">
                {tr('home.secondary')}
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <figure class="mx-auto max-w-sm lg:max-w-none lg:mt-14 lg:pl-8">
              <div class="overflow-hidden rounded-sm border border-text-primary/15">
                <img
                  src={cover}
                  alt={locale === 'vi' ? 'Bìa Sách Một' : 'The Thread Seers: Book One — cover'}
                  width="1024"
                  height="1536"
                  class="aspect-[2/3] w-full object-cover"
                  loading="eager"
                />
              </div>
              <figcaption class="mt-3 font-mono text-xs uppercase tracking-[0.18em] text-text-secondary">
                {locale === 'vi' ? 'Những Người Thấy Sợi Chỉ · Sách Một · Bìa' : 'Thread Seers · Book One · Cover'}
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      {/* ——— Seam & Scar premise rail ——— */}
      <section class="mx-auto max-w-canvas px-6 py-16 lg:px-8 lg:py-24">
        <ThreadDivider />
        <p class="eyebrow mt-12">{tr('home.premise.eyebrow')}</p>
        <div class="mt-10 space-y-14 lg:space-y-20">
          {
            premiseRows.map((row, i) => (
              <div class="grid gap-4 lg:grid-cols-12 lg:gap-8">
                <p
                  class:list={[
                    'font-mono text-sm tracking-[0.2em] text-accent-thread lg:col-span-2',
                    i % 2 === 1 ? 'lg:order-2 lg:text-right' : '',
                  ]}
                >
                  {row.numeral}
                </p>
                <div
                  class:list={[
                    'lg:col-span-7',
                    i % 2 === 1 ? 'lg:order-1 lg:col-start-4' : 'lg:col-start-3',
                  ]}
                >
                  <h2 class="font-display text-h2 font-normal text-text-primary">
                    {row.title[locale]}
                  </h2>
                  <p class="mt-4 max-w-prose font-serif text-body leading-relaxed text-text-body">
                    {row.body[locale]}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mx-auto max-w-canvas px-6 py-8 lg:px-8 lg:py-12">
        <div class="lg:ml-[16%] lg:max-w-3xl">
          <PullQuote cite={tr('home.quoteCite')}>{tr('home.quote')}</PullQuote>
        </div>
      </section>

      {/* ——— The quartet ——— */}
      <section class="mx-auto max-w-canvas px-6 py-16 lg:px-8 lg:py-24">
        <ThreadDivider />
        <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p class="eyebrow">{tr('home.quartet.eyebrow')}</p>
            <h2 class="mt-4 font-display text-h2 font-normal text-text-primary">
              {tr('home.quartet.title')}
            </h2>
            <p class="mt-5 font-serif text-body leading-relaxed text-text-body">
              {tr('home.quartet.body')}
            </p>
          </div>
          <div class="lg:col-span-7 lg:col-start-6">
            <RelationshipMap locale={locale} nodes={quartetNodes} />
          </div>
        </div>
      </section>

      {/* ——— Final hold ——— */}
      <section class="mx-auto max-w-canvas px-6 pb-24 pt-4 lg:px-8">
        <ThreadDivider />
        <div class="mt-14 max-w-2xl lg:mt-20">
          <h2 class="font-display text-h2 font-normal text-text-primary">
            {tr('home.final.title')}
          </h2>
          <p class="mt-4 font-serif text-body leading-relaxed text-text-body">
            {tr('home.final.body')}
          </p>
          <div class="mt-8 flex flex-col items-start gap-5">
            <HoldCta locale={locale} href={epub} label={tr('home.final.cta')} />
            <a
              href={localePath(locale, locale === 'vi' ? '/series/book-one/read/chapter-1' : '/series/book-one/read/prologue')}
              class="ghost-link text-text-secondary hover:text-text-primary"
            >
              {locale === 'vi' ? 'Đọc Chương 1' : 'Read Chapter 1'}
            </a>
          </div>
        </div>
        <p class="mt-12 font-mono text-xs uppercase tracking-[0.18em] text-text-muted">
          {locale === 'vi' ? `${TOTAL_PARTS} phần · tiếng Anh và tiếng Việt` : `${TOTAL_PARTS} parts · English and Vietnamese`}
        </p>
      </section>
    </main>
  </Page>
</Base>
