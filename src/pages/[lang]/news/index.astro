---
import Base from '../../../layouts/Base.astro'
import Page from '../../../components/Page.astro'
import ThreadDivider from '../../../components/ThreadDivider.astro'
import { isLocale } from '../../../lib/chapters'
import { t } from '../../../lib/i18n'
import { jsonLd, keywordsFor, localePath } from '../../../lib/seo'
import { newsPosts } from '../../../lib/content'

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'vi' } }]
}

const lang = Astro.params.lang!
if (!isLocale(lang)) return Astro.redirect('/en/')
const locale = lang
const tr = (k: Parameters<typeof t>[1], v?: Record<string, string | number>) => t(locale, k, v)

const title =
  locale === 'vi' ? 'Dư âu và thông báo — Những Người Thấy Sợi Chỉ' : 'Echoes and announcements — The Thread Seers'
const description =
  locale === 'vi'
    ? 'Tin tức và cập nhật từ tác giả Những Người Thấy Sợi Chỉ: phát hành, công bố bộ sách, và ghi chú sau lưng bìa.'
    : 'News and updates from the author of The Thread Seers: releases, series announcements, and behind-the-book notes.'

const schema = jsonLd({
  locale,
  path: '/news',
  title,
  description,
  type: 'website',
  withBook: true,
})

const dateFmt = locale === 'vi' ? 'vi-VN' : 'en-US'
const dateLong = { year: 'numeric', month: 'long', day: 'numeric' } as const
---

<Base
  locale={locale}
  path="/news"
  title={title}
  description={description}
  keywords={keywordsFor(locale, 'author updates')}
  jsonLd={schema}
  type="website"
>
  <Page locale={locale} path="/news">
    <div class="mx-auto max-w-canvas px-6 py-16 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">{tr('news.eyebrow')}</p>
        <h1 class="mt-5 font-display text-h1 font-light text-text-primary">
          {tr('news.title')}
        </h1>
      </div>

      <ThreadDivider class="mt-14 lg:mt-20" />

      <div>
        {
          newsPosts.map((post) => (
            <article class="grid gap-3 border-b border-text-primary/10 py-10 lg:grid-cols-12 lg:gap-8">
              <time
                class="font-mono text-xs uppercase tracking-[0.18em] text-text-secondary lg:col-span-3 lg:pt-2"
                datetime={post.date}
              >
                {new Date(post.date).toLocaleDateString(dateFmt, dateLong)}
              </time>
              <div class="lg:col-span-8">
                <h2 class="font-display text-h2 font-normal text-text-primary">
                  <a
                    href={localePath(locale, `/news/${post.slug}`)}
                    class="transition-colors duration-300 hover:text-accent-thread"
                  >
                    {post.title[locale]}
                  </a>
                </h2>
                <p class="mt-3 max-w-prose font-serif text-body leading-relaxed text-text-body">
                  {post.excerpt[locale]}
                </p>
                <a
                  href={localePath(locale, `/news/${post.slug}`)}
                  class="ghost-link mt-4 text-text-secondary hover:text-text-primary"
                >
                  {tr('news.readPost')}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Page>
</Base>
