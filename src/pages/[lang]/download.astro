---
import Base from '../../layouts/Base.astro'
import Page from '../../components/Page.astro'
import HoldCta from '../../components/HoldCta.astro'
import ThreadDivider from '../../components/ThreadDivider.astro'
import AudioPlayer from '../../components/AudioPlayer.astro'
import { isLocale, TOTAL_PARTS, chapterOrder, titleFor } from '../../lib/chapters'
import { getAvailableAudioTracks } from '../../lib/audio'
import { t } from '../../lib/i18n'
import { SITE, jsonLd, keywordsFor, localePath, faq } from '../../lib/seo'

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'vi' } }]
}

const lang = Astro.params.lang!
if (!isLocale(lang)) return Astro.redirect('/en/')
const locale = lang
const tr = (k: Parameters<typeof t>[1], v?: Record<string, string | number>) => t(locale, k, v)

const title =
  locale === 'vi'
    ? 'Tải Sách Một Miễn Phí — EPUB, PDF, Markdown'
    : 'Download Book One Free — EPUB, PDF, Markdown'
const description =
  locale === 'vi'
    ? `Trọn vẹn tác phẩm Những Người Thấy Sợi Chỉ: Sách Một, tải về miễn phí ở các định dạng EPUB, PDF và Markdown, bằng cả tiếng Anh lẫn tiếng Việt. Đầy đủ ${TOTAL_PARTS} phần, không cắt đoạn, không tường phí.`
    : `The complete novel The Thread Seers: Book One, free to download in EPUB, PDF, and clean Markdown, in parallel English and Vietnamese editions. All ${TOTAL_PARTS} parts, unabridged, without paywalls.`

const schema = jsonLd({
  locale,
  path: '/download',
  title,
  description,
  type: 'website',
  faq: faq[locale],
  withBook: true,
})

// Sizes are read from disk at build time; import here so a missing artifact
// fails the build (artifacts.ts throws) rather than shipping a dead link.
const { artifacts, sizeLabel, platformLinks } = await import('../../lib/artifacts')

const groups = {
  en: artifacts.filter((a) => a.locale === 'en'),
  vi: artifacts.filter((a) => a.locale === 'vi'),
}
const mine = groups[locale]
const other = groups[locale === 'vi' ? 'en' : 'vi']

const ownEpub = mine.find((a) => a.format === 'EPUB3')
const firstChapter = chapterOrder.find((c) => c.kind === 'front' && c.slug === 'prologue')!

const audioTracks = getAvailableAudioTracks(locale)
const otherAudioTracks = getAvailableAudioTracks(locale === 'vi' ? 'en' : 'vi')
---

<Base
  locale={locale}
  path="/download"
  title={title}
  description={description}
  keywords={keywordsFor(locale, 'epub, pdf, free download, audiobook, sach noi, mp3')}
  jsonLd={schema}
  type="website"
>
  <Page locale={locale} path="/download">
    <div class="mx-auto max-w-canvas px-6 py-16 lg:px-8 lg:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">{tr('download.eyebrow')}</p>
        <h1 class="mt-5 font-display text-h1 font-light text-text-primary">
          {tr('download.title')}
        </h1>
        <p class="mt-6 max-w-prose font-serif text-body leading-relaxed text-text-body">
          {tr('download.body', { parts: TOTAL_PARTS })}
        </p>
        {
          ownEpub && (
            <div class="mt-9 flex flex-col items-start gap-5">
              <HoldCta
                locale={locale}
                href={`/books/${ownEpub.file}`}
                label={locale === 'vi' ? 'Giữ lấy sợi chỉ — tải EPUB' : 'Hold the thread — EPUB'}
                hint={tr('common.hold')}
              />
              <a
                href={localePath(locale, `/series/book-one/read/${firstChapter.slug}`)}
                class="ghost-link text-text-secondary hover:text-text-primary"
              >
                {tr('download.read.cta')}
              </a>
            </div>
          )
        }
      </div>

      <ThreadDivider class="mt-14 lg:mt-20" />

      {/* Ledger for this locale */}
      <section class="mt-12">
        <p class="eyebrow">
          {locale === 'vi' ? 'Sổ lưu · Ấn bản tiếng Việt' : 'Ledger · English edition'}
        </p>
        <ul class="mt-6 border-t border-text-primary/10">
          {
            mine.map((item) => (
              <li>
                <a
                  href={`/books/${item.file}`}
                  download
                  class="group grid grid-cols-12 items-baseline gap-2 border-b border-text-primary/10 py-5 transition-colors duration-300 hover:bg-text-primary/[0.03]"
                >
                  <span class="col-span-4 font-mono text-sm tracking-[0.12em] text-text-primary sm:col-span-2">
                    {item.format}
                  </span>
                  <span class="col-span-8 font-serif text-body text-text-body sm:col-span-6">
                    {item.note[locale]}
                  </span>
                  <span class="col-span-6 font-mono text-xs text-text-secondary sm:col-span-2">
                    {sizeLabel(item.bytes, locale)} · {tr('common.fullText')}
                  </span>
                  <span class="col-span-6 flex justify-end text-text-secondary transition-colors group-hover:text-accent-thread sm:col-span-2">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {/* The other-language edition, always shown so both are discoverable */}
      <section class="mt-16">
        <p class="eyebrow">
          {locale === 'vi' ? 'Bản tiếng Anh' : 'Vietnamese edition'}
        </p>
        <ul class="mt-4 flex flex-col items-start gap-1">
          {
            other.map((item) => (
              <li>
                <a href={`/books/${item.file}`} download class="ghost-link text-sm text-text-secondary hover:text-text-primary">
                  {item.format} · {sizeLabel(item.bytes, locale)} ·{' '}
                  {locale === 'vi' ? 'tải bản tiếng Anh' : 'Download Vietnamese edition'}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {/* Sách nói / Audiobook section */}
      {audioTracks.length > 0 && (
        <>
          <ThreadDivider class="mt-16 lg:mt-24" />
          <section class="mt-12" id="audiobook">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-4">
              <div>
                <p class="eyebrow">{tr('audio.downloadSectionTitle')}</p>
                <h2 class="mt-2 font-display text-h2 font-normal text-text-primary">
                  {locale === 'vi' ? 'Sách Nói Trực Tuyến & Tải Về' : 'Audiobook Online & Downloads'}
                </h2>
              </div>
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  data-download-play-all
                  class="inline-flex items-center gap-2 rounded-sm bg-accent-thread px-4 py-2 font-mono text-xs uppercase tracking-wider text-background-primary transition-all duration-200 hover:bg-[#d3af66] active:scale-95 shadow-sm"
                  title={tr('audio.playAll')}
                >
                  <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  <span>{tr('audio.playAll')}</span>
                </button>
                <span class="font-mono text-xs uppercase tracking-wider text-accent-thread">
                  {tr('audio.allChapters', { count: audioTracks.length })}
                </span>
              </div>
            </div>
            <p class="mt-4 max-w-prose font-serif text-body leading-relaxed text-text-body">
              {tr('audio.downloadSectionBody')}
            </p>

            <AudioPlayer
              track={audioTracks[0]}
              locale={locale}
              title={titleFor(audioTracks[0].chapter, locale)}
              class="mt-8 mb-10"
            />

            <div class="border-t border-text-primary/10">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-6">
                {audioTracks.map((track) => {
                  const heading = titleFor(track.chapter, locale)
                  const readUrl = localePath(locale, `/series/book-one/read/${track.slug}?autoplay=1`)
                  return (
                    <div
                      data-audio-card
                      data-slug={track.slug}
                      class="group flex items-center justify-between gap-3 rounded-sm border border-text-primary/10 bg-background-secondary/50 p-4 transition-all duration-200 hover:border-accent-thread/40 hover:bg-background-secondary"
                    >
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                          <span
                            data-active-dot
                            class="hidden h-2 w-2 flex-shrink-0 rounded-full bg-accent-thread animate-thread-breathe"
                            title={tr('audio.nowPlaying')}
                          ></span>
                          <span
                            data-cue-title
                            class="truncate font-sans text-sm font-medium text-text-primary cursor-pointer hover:text-accent-thread transition-colors"
                          >
                            {heading}
                          </span>
                        </div>
                        <span class="font-mono text-[0.7rem] uppercase tracking-wider text-text-muted block mt-0.5">
                          {track.sizeLabel} · {locale === 'vi' ? `Phần ${track.chapter.label}` : `Part ${track.chapter.label}`}
                        </span>
                      </div>
                      <div class="flex items-center gap-2 flex-shrink-0">
                        <button
                          type="button"
                          data-cue-track={track.slug}
                          class="inline-flex items-center gap-1.5 rounded-sm border border-text-primary/15 px-2.5 py-1.5 font-mono text-xs text-text-secondary hover:border-accent-thread hover:text-accent-thread transition-colors"
                          title={tr('audio.playTrack')}
                          aria-label={`${tr('audio.playTrack')} - ${heading}`}
                        >
                          <svg data-card-play-icon class="h-3 w-3 fill-current" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z" />
                          </svg>
                          <svg data-card-pause-icon class="hidden h-3 w-3 fill-current text-accent-thread" viewBox="0 0 24 24">
                            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                          </svg>
                          <span data-card-btn-text class="hidden sm:inline">{tr('audio.playTrack')}</span>
                        </button>
                        <a
                          href={readUrl}
                          class="inline-flex items-center gap-1.5 rounded-sm border border-text-primary/15 px-2.5 py-1.5 font-mono text-xs text-text-secondary hover:border-accent-thread hover:text-accent-thread transition-colors"
                          title={tr('audio.readAndListen')}
                        >
                          <span class="hidden sm:inline">{tr('audio.readAndListen')}</span>
                          <span class="sm:hidden">📖</span>
                        </a>
                        <a
                          href={track.url}
                          download={track.downloadName}
                          class="inline-flex items-center gap-1.5 rounded-sm bg-text-primary/10 px-2.5 py-1.5 font-mono text-xs text-text-primary hover:bg-accent-thread hover:text-background-primary transition-colors"
                          title={tr('audio.downloadMp3')}
                        >
                          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3v13m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
                          </svg>
                          <span>MP3</span>
                        </a>
                      </div>
                    </div>
                  )
                })}
              </div>
            </div>
          </section>
        </>
      )}

      {/* If this locale doesn't have audio but the other locale does, show a discovery link */}
      {audioTracks.length === 0 && otherAudioTracks.length > 0 && (
        <section class="mt-12">
          <p class="eyebrow">
            {locale === 'vi' ? 'Bản thu âm tiếng Anh' : 'Vietnamese Audiobook'}
          </p>
          <p class="mt-2 font-serif text-sm text-text-body">
            {locale === 'vi'
              ? 'Bản thu âm tiếng Anh đang được hoàn thiện.'
              : `${otherAudioTracks.length} chapters are recorded and available for online listening and MP3 download in the Vietnamese edition.`}
          </p>
          <a
            href={localePath('vi', '/download#audiobook')}
            class="ghost-link mt-2 text-sm text-text-secondary hover:text-text-primary"
          >
            {locale === 'vi' ? 'Xem các bản thu âm' : 'Listen to Vietnamese audiobook edition'} →
          </a>
        </section>
      )}

      <ThreadDivider class="mt-16 lg:mt-24" />

      <div class="mt-14 grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="font-display text-h2 font-normal text-text-primary">
            {tr('download.read.title')}
          </h2>
          <p class="mt-4 font-serif text-body leading-relaxed text-text-body">
            {tr('download.read.body')}
          </p>
          <a
            href={localePath(locale, `/series/book-one/read/${firstChapter.slug}`)}
            class="ghost-link mt-5"
          >
            {tr('download.read.cta')}
          </a>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <h2 class="font-display text-h2 font-normal text-text-primary">
            {tr('download.stores.title')}
          </h2>
          <p class="mt-4 font-serif text-body leading-relaxed text-text-body">
            {tr('download.stores.body')}
          </p>
          <div class="mt-5 flex flex-col items-start gap-1">
            {
              platformLinks.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="ghost-link">
                  {locale === 'vi' ? 'Mở trên ' : 'Open on '}
                  {link.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Page>

  <script>
    function initAudiobookSection() {
      const playAllBtn = document.querySelector<HTMLButtonElement>('[data-download-play-all]')
      const cards = document.querySelectorAll<HTMLElement>('[data-audio-card]')
      const playerEl = document.querySelector<HTMLElement>('[data-audio-player]')

      if (playAllBtn && !playAllBtn.dataset.wired) {
        playAllBtn.dataset.wired = 'true'
        playAllBtn.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('ts-play-all'))
          playerEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
        })
      }

      cards.forEach((card) => {
        if (card.dataset.wired === 'true') return
        card.dataset.wired = 'true'
        const slug = card.dataset.slug
        if (!slug) return

        const cueBtn = card.querySelector<HTMLButtonElement>('[data-cue-track]')
        const cueTitle = card.querySelector<HTMLElement>('[data-cue-title]')

        const triggerPlay = () => {
          window.dispatchEvent(
            new CustomEvent('ts-cue-track', {
              detail: { slug, autoPlay: true },
            })
          )
        }

        cueBtn?.addEventListener('click', (e) => {
          e.stopPropagation()
          triggerPlay()
        })

        cueTitle?.addEventListener('click', triggerPlay)
      })

      window.addEventListener('ts-track-status', (e: Event) => {
        const custom = e as CustomEvent<{ slug: string; isPlaying: boolean }>
        const activeSlug = custom.detail?.slug
        const isPlaying = custom.detail?.isPlaying ?? false

        cards.forEach((card) => {
          const slug = card.dataset.slug
          const isActive = slug === activeSlug
          const dot = card.querySelector<HTMLElement>('[data-active-dot]')
          const playIcon = card.querySelector<HTMLElement>('[data-card-play-icon]')
          const pauseIcon = card.querySelector<HTMLElement>('[data-card-pause-icon]')

          if (isActive) {
            card.classList.add('border-accent-thread', 'bg-background-secondary', 'ring-1', 'ring-accent-thread/40')
            dot?.classList.remove('hidden')
            if (isPlaying) {
              playIcon?.classList.add('hidden')
              pauseIcon?.classList.remove('hidden')
            } else {
              playIcon?.classList.remove('hidden')
              pauseIcon?.classList.add('hidden')
            }
          } else {
            card.classList.remove('border-accent-thread', 'bg-background-secondary', 'ring-1', 'ring-accent-thread/40')
            dot?.classList.add('hidden')
            playIcon?.classList.remove('hidden')
            pauseIcon?.classList.add('hidden')
          }
        })
      })
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAudiobookSection)
    } else {
      initAudiobookSection()
    }
    document.addEventListener('astro:page-load', initAudiobookSection)
  </script>
</Base>
